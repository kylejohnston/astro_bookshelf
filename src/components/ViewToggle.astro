---
interface Props { view: 'grid' | 'list' | 'favorites' }
const { view } = Astro.props;

const favActive = view === 'favorites';
const gridActive = view !== 'list';

const heartOutline = 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z';
const heartSolid = 'm11.645 20.91-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z';
const squares = 'M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z';

// Active icons are filled, inactive ones outlined.
const fill = (active: boolean) => active
  ? { fill: 'currentColor' }
  : { fill: 'none', stroke: 'currentColor', 'stroke-width': 1.5, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' };

const favLabel = favActive ? 'Show all books' : 'Show favorites';
const gridLabel = gridActive ? 'Switch to list view' : 'Switch to grid view';
---
<div class="col-span-1 m-0 pl-4 py-1.5 flex gap-2 content-start justify-end items-start">
  <a href={favActive ? '/' : '/favorites'} class="icon-link" data-active={favActive || undefined} aria-label={favLabel} title={favLabel}>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon" aria-hidden="true" {...fill(favActive)}>
      <path d={favActive ? heartSolid : heartOutline} />
    </svg>
  </a>
  <a href={gridActive ? '/list' : '/'} class="icon-link" data-active={gridActive || undefined} aria-label={gridLabel} title={gridLabel}>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon" aria-hidden="true" {...fill(gridActive)}>
      <path d={squares} />
    </svg>
  </a>
</div>

<style>
  .icon { width: 24px; height: 24px; }
</style>
