---
import BaseHead from '@components/BaseHead.astro'; // <head>
import Footer from '@components/Footer.astro';
import MainNav from '@components/MainNav.astro'; // logo, nav
import BuyBook from '@components/BuyBook.astro';
import { formatDate } from '../lib/format';

const { title, author, coverImage, added, reread, library, bookshop, amazon, other } = Astro.props;
const bookCover = `/covers/${coverImage}`;
const pageTitle = `${title} by ${author}`;
const permalink = Astro.url.href;
---

<html lang="en">
	<head>
		<BaseHead {pageTitle} {permalink} />
	</head>

	<body>
		<MainNav /> <!-- logo, nav -->
    <article class="book-details" data-pagefind-body>
      <header>
        <h1 class="title">{title}</h1>
        <h2 class="author"><span>by </span> {author}</h2>
      </header>
      <div class="book-content">
        <main>
          <section>
            <div class="reading-time">
              { added && <div><h3 class="h4">Added:</h3><p>{formatDate(added)}</p></div> }
              { reread && <div><h3 class="h4">reread:</h3><p>{formatDate(reread)}</p></div> }
            </div>
            <h3>Book Description</h3>
            <slot />
            <BuyBook {library} {bookshop} {amazon} {other} />
          </section>
        </main>
        <div class="book-cover-col">
            <img
              src={bookCover}
              alt={pageTitle}
              width="480"
              height="960"
              loading="lazy"
              decoding="async"
              class="book-cover lg:!sticky lg:top-8"
              />
        </div>
      </div>
    </article>
    <Footer />
	</body>
</html>
