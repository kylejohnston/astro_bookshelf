{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@assets/*": ["src/assets/*"],
    },
    // Add type definitions for our Vite runtime.
    "types": ["vite/client"],
    // TypeScript for Content Collections
    "strictNullChecks": true,
  }
}
